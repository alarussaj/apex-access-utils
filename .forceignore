# Exclude example classes from package deployment.
# These are documentation only and reference fictional objects/loggers;
# they should never be deployed to a scratch org or packaged.
docs/

# Standard SFDX excludes
**/jsconfig.json
**/.eslintrc.json
**/.prettierrc
**/.prettierignore

# Profiles and settings that shouldn't be packaged
**/profiles/**
**/settings/**

# Metadata that commonly causes deploy noise
package.xml
