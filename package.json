{
  "name": "apex-access-utils",
  "version": "0.1.0",
  "description": "Apex utilities for enforcing object and field-level security with consistent error handling and observability.",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"**/*.{cls,trigger,js,json,md,xml,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{cls,trigger,js,json,md,xml,yml,yaml}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alarussaj/apex-access-utils.git"
  },
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.6",
    "prettier": "^3.3.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,trigger,js,json,md,xml,yml,yaml}": [
      "prettier --write"
    ]
  }
}
